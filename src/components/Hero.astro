---
import Button from './Button.astro';
import Badge from './Badge.astro';
import {Image} from 'astro:assets';
import portada from "@icons/fondo_portada.png"
import { resolvePath } from '../utils/navigation';
---

<section class="relative pt-15 pb-15 overflow-hidden">
  <!-- Complex Animated Background -->
  <div class="absolute inset-0 -z-10 bg-white dark:bg-[#09090b]">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgwLDAsMCwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] dark:bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] [mask-image:linear-gradient(to_bottom,white,transparent)]"></div>
    <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-[800px] h-[600px] bg-[#d32f2f]/20 dark:bg-[#d32f2f]/30 rounded-full blur-[120px] opacity-80 mix-blend-multiply dark:mix-blend-screen animate-pulse"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[500px] bg-[#0b1d3a]/20 dark:bg-[#0b1d3a]/30 rounded-full blur-[100px] opacity-80 mix-blend-multiply dark:mix-blend-screen"></div>
  </div> 
  
  <div class="container mx-auto px-4 sm:px-6 text-center reveal-on-scroll">
    <!-- <div class="flex justify-center mb-8">
      <Badge variant="primary" class="px-4 py-1.5 text-sm border border-primary-200 dark:border-[#d32f2f] backdrop-blur-md bg-white/50 dark:bg-[#d32f2f]/50">
         IMPORTADORA SUCRE
      </Badge>
    </div> -->
    
    
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-heading font-extrabold tracking-tight text-slate-900 dark:text-white mb-8 max-w-5xl mx-auto leading-[1.1]">
      <span class="text-gradient">Importadora Sucre</span>
      <br class="hidden sm:block" />
      Sitio web en construcción.
    </h1>
    
    <p class="text-xl sm:text-2xl text-slate-600 dark:text-slate-400 mb-12 max-w-3xl mx-auto font-sans leading-relaxed">
      Estamos trabajando arduamente para traerte la mejor experiencia. Pronto podrás explorar nuestros productos y servicios de manera más eficiente y atractiva.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
      <Button href="mailto:info@importadorasucre.ec" variant="primary" size="lg" target="_blank" class="w-full sm:w-auto text-lg px-8 py-4 shadow-xl shadow-[#d32f2f]/20">
        Ponte en contacto con nosotros
      </Button>
      <!-- <Button href="#features" variant="outline" size="lg" class="w-full sm:w-auto text-lg px-8 py-4 bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm">
        Explore Features
      </Button> -->
    </div>

    <!-- Complex Mockup Image Area -->
    <div class="relative mx-auto max-w-6xl reveal-on-scroll" style="transition-delay: 200ms;">
      <div class="aspect-[16/9] rounded-3xl bg-slate-900 dark:bg-[#111116] shadow-2xl border border-slate-800 dark:border-slate-800/80 flex items-center justify-center overflow-hidden relative group hover-glow">
        
        <!-- Mac-style window controls -->
        <!-- <div class="absolute top-4 left-4 flex gap-2 z-20">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
        </div> -->

        <!-- Inner mock grid -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:24px_24px] z-0"></div>
        
        <div class="relative z-10  rounded-2xl glass-panel text-left w-3/4 max-w-2xl transform transition-transform group-hover:scale-[1.02] duration-500">
          <Image src={portada} alt="Mockup" width={800} height={450} class="w-full h-auto rounded-lg shadow-lg" />
        </div>
      </div>
      
      <!-- Decorative background blur behind mockup -->
      <div class="absolute -top-12 -left-12 -z-10 w-96 h-96 bg-[#0b1d3a]/30 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px]"></div>
      <div class="absolute -bottom-12 -right-12 -z-10 w-96 h-96 bg-[#d32f2f]/30 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px]"></div>
    </div>
  </div>
</section>
